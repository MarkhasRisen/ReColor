   "source": [
    "# ═══════════════════════════════════════════════════════════════\n# REAL IMAGE TEST  —  algo/test_image.jpg\n#\n# Save any photo as  algo/test_image.jpg  then run this cell.\n# Shows four panels:\n#   Input (256×256)  |  CIELAB Ground Truth  |  CNN Prediction  |  50/50 Overlay\n# ═══════════════════════════════════════════════════════════════\nimport os\nfrom PIL import Image as PILImage\n\nIMAGE_PATH = 'test_image.jpg'\n\nif not os.path.exists(IMAGE_PATH):\n    raise FileNotFoundError(\n        f\"'{IMAGE_PATH}' not found.\\n\"\n        \"Save your test photo to  algo/test_image.jpg  and re-run this cell.\"\n    )\n\n# ── Load and resize to 256×256 ──────────────────────────────────\npil_img  = PILImage.open(IMAGE_PATH).convert('RGB')\npil_128  = pil_img.resize((IMG_SIZE, IMG_SIZE), PILImage.LANCZOS)\ntest_img = np.array(pil_128, dtype=np.uint8)   # (256,256,3)\n\n# ── CIELAB ground-truth label (what the labeler assigns) ────────\ngt_mask = generate_mask_lab(test_img)\n\n# ── CNN prediction ───────────────────────────────────────────────\npred_raw  = model.predict(np.expand_dims(test_img / 255.0, 0), verbose=0)\npred_mask = np.argmax(pred_raw[0], axis=-1).astype(np.uint8)   # (128,128)\n\n# ── Colour palette (matches CLASS_NAMES order) ───────────────────\nPALETTE = np.array([\n    [180,180,180],  # 0 Neutral  — grey\n    [220, 38, 38],  # 1 Red\n    [249,115, 22],  # 2 Orange\n    [234,179,  8],  # 3 Yellow\n    [ 34,140, 34],  # 4 Green\n    [  6,182,212],  # 5 Cyan\n    [ 37, 99,235],  # 6 Blue\n    [124, 58,237],  # 7 Violet\n    [236, 72,153],  # 8 Pink\n    [146, 64, 14],  # 9 Brown\n], dtype=np.uint8)\n\nseg_gt   = PALETTE[gt_mask]\nseg_pred = PALETTE[pred_mask]\noverlay  = (test_img.astype(np.float32) * 0.5 +\n            seg_pred.astype(np.float32) * 0.5).astype(np.uint8)\n\n# ── Per-class pixel counts (CNN prediction) ──────────────────────\nunique, counts = np.unique(pred_mask, return_counts=True)\nprint(\"CNN prediction — pixel counts per class:\")\nfor cls_id, cnt in zip(unique, counts):\n    pct = cnt / (IMG_SIZE ** 2) * 100\n    print(f\"  {cls_id:2d} {CLASS_NAMES[cls_id]:<8s}  {cnt:5d} px  ({pct:.1f}%)\")\n\n# ── Plot ─────────────────────────────────────────────────────────\nfig, axes = plt.subplots(1, 4, figsize=(20, 5))\naxes[0].imshow(test_img);  axes[0].set_title('Input (256×256)',           fontsize=12); axes[0].axis('off')\naxes[1].imshow(seg_gt);    axes[1].set_title('CIELAB Label (Ground Truth)', fontsize=12); axes[1].axis('off')\naxes[2].imshow(seg_pred);  axes[2].set_title('CNN Prediction',             fontsize=12); axes[2].axis('off')\naxes[3].imshow(overlay);   axes[3].set_title('Overlay (50/50)',            fontsize=12); axes[3].axis('off')\n\nfrom matplotlib.patches import Patch\nlegend_elements = [\n    Patch(facecolor=PALETTE[i] / 255.0, label=f'{i} {CLASS_NAMES[i]}')\n    for i in range(NUM_CLASSES)\n]\nfig.legend(handles=legend_elements, loc='lower center', ncol=5,\n           fontsize=9, framealpha=0.85)\nplt.tight_layout(rect=[0, 0.1, 1, 1])\nplt.show()\n"
