        headerShown: false,
        tabBarActiveTintColor: COLORS.primary,
        tabBarInactiveTintColor: COLORS.textLight,
        tabBarStyle: {
          height: 65,
          paddingTop: 5,
          paddingBottom: 5,
          backgroundColor: '#FFFFFF',
