            <Text style={{ marginLeft: 5, color: '#1565C0', fontWeight: 'bold' }}>Demo Credentials (Testing Only):</Text>
          </View>

          <TouchableOpacity
            style={{ backgroundColor: '#FFF', padding: 12, borderRadius: 8, marginBottom: 10, borderLeftWidth: 4, borderLeftColor: '#6C63FF' }}
