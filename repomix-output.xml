                ? "#9C27B0"
                : COLORS.warning
          }
        />
        <Text style={styles.heroLabel}>Screening Result</Text>
        <Text style={styles.heroDiagnosis}>{displayDiagnosis}</Text>

        <ScoreRing percentage={percentage} color={severityColor} />

        <Text style={styles.heroScore}>
