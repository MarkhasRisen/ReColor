    borderRadius: RADIUS.md,
    paddingVertical: 14,
    alignItems: 'center',
    marginTop: SPACING.md,
    ...SHADOW.sm,
  },
  signUpBtnText: { color: '#FFF', fontWeight: '700', fontSize: 16 },
