   "source": [
    "# ═══════════════════════════════════════════════════════════════\n",
    "# CELL 1.3 — COMPREHENSIVE EVALUATION METRICS\n",
    "#\n",
    "# Computes Precision, Recall, F1-Score, Confusion Matrix,\n",
    "# Top-1 Accuracy, CIEDE2000 ΔE per class, and JND threshold analysis.\n",
    "# ═══════════════════════════════════════════════════════════════\n",
    "from sklearn.metrics import confusion_matrix, precision_recall_fscore_support, accuracy_score\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "print(\"═\" * 80)\n",
    "print(\"COMPREHENSIVE EVALUATION METRICS\")\n",
    "print(\"═\" * 80)\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────\n",
    "# 1. Make predictions on test set\n",
    "# ─────────────────────────────────────────────────────────────────\n",
    "print(\"\\nGenerating predictions on test set ...\")\n",
    "y_pred_probs = model.predict(X_test, verbose=0)\n",
    "y_pred       = np.argmax(y_pred_probs, axis=1)\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────\n",
    "# 2. Top-1 Accuracy\n",
    "# ─────────────────────────────────────────────────────────────────\n",
    "top1_acc = accuracy_score(y_test, y_pred)\n",
    "print(f\"\\n{'■' * 80}\")\n",
    "print(f\"METRIC 1: TOP-1 ACCURACY (Primary User-Facing Metric)\")\n",
    "print(f\"{'■' * 80}\")\n",
    "print(f\"Top-1 Accuracy: {top1_acc:.1%} ({int(np.sum(y_pred == y_test))} / {len(y_test)} correct)\")\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────\n",
    "# 3. Precision, Recall, F1-Score (per class + macro-average)\n",
    "# ─────────────────────────────────────────────────────────────────\n",
    "print(f\"\\n{'■' * 80}\")\n",
    "print(f\"METRICS 2-4: PRECISION, RECALL, F1-SCORE (Per Class + Macro-Average)\")\n",
    "print(f\"{'■' * 80}\\n\")\n",
    "\n",
    "precision, recall, f1, support = precision_recall_fscore_support(\n",
    "    y_test, y_pred, labels=range(NUM_CLASSES), zero_division=0\n",
    ")\n",
    "\n",
    "# Print per-class metrics\n",
    "print(f\"{'Class':<12} {'Name':<10} {'Precision':<12} {'Recall':<12} {'F1-Score':<12} {'Support':<8}\")\n",
    "print(\"─\" * 80)\n",
    "for cls in range(NUM_CLASSES):\n",
    "    print(f\"{cls:<12} {CLASS_NAMES[cls]:<10} {precision[cls]:>10.1%}  {recall[cls]:>10.1%}  {f1[cls]:>10.1%}  {int(support[cls]):>6}\")\n",
    "\n",
    "# Macro-averages\n",
    "macro_precision = np.mean(precision)\n",
    "macro_recall    = np.mean(recall)\n",
    "macro_f1        = np.mean(f1)\n",
    "\n",
    "print(\"─\" * 80)\n",
    "print(f\"{'MACRO-AVG':<12} {'':10} {macro_precision:>10.1%}  {macro_recall:>10.1%}  {macro_f1:>10.1%}  {int(np.sum(support)):>6}\")\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────\n",
    "# 4. Confusion Matrix (10 × 10)\n",
    "# ─────────────────────────────────────────────────────────────────\n",
    "print(f\"\\n{'■' * 80}\")\n",
    "print(f\"METRIC 5: CONFUSION MATRIX (10 × 10)\")\n",
    "print(f\"{'■' * 80}\\n\")\n",
    "\n",
    "cm = confusion_matrix(y_test, y_pred, labels=range(NUM_CLASSES))\n",
    "\n",
    "# Visualize confusion matrix as heatmap\n",
    "fig, ax = plt.subplots(figsize=(12, 10))\n",
    "im = ax.imshow(cm, interpolation='nearest', cmap='Blues', aspect='auto')\n",
    "\n",
    "# Set ticks and labels\n",
    "ax.set_xticks(np.arange(NUM_CLASSES))\n",
    "ax.set_yticks(np.arange(NUM_CLASSES))\n",
    "ax.set_xticklabels(CLASS_NAMES, rotation=45, ha='right')\n",
    "ax.set_yticklabels(CLASS_NAMES)\n",
    "\n",
    "# Add colorbar\n",
    "cbar = plt.colorbar(im, ax=ax)\n",
    "cbar.set_label('Count', rotation=270, labelpad=20)\n",
    "\n",
    "# Add text annotations\n",
    "for i in range(NUM_CLASSES):\n",
    "    for j in range(NUM_CLASSES):\n",
    "        text = ax.text(j, i, f'{cm[i, j]}',\n",
    "                      ha=\"center\", va=\"center\",\n",
    "                      color=\"white\" if cm[i, j] > cm.max() / 2 else \"black\",\n",
    "                      fontsize=9, fontweight='bold')\n",
    "\n",
    "ax.set_xlabel('Predicted Label', fontsize=12, fontweight='bold')\n",
    "ax.set_ylabel('True Label', fontsize=12, fontweight='bold')\n",
    "ax.set_title('Confusion Matrix — Color Identifier V3', fontsize=14, fontweight='bold')\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(f\"Confusion Matrix (rows=true label, cols=predicted label):\\n{cm}\")\n",
    "\n",
    "# ─────────────────────────────────────────────────────────────────\n",
    "# 5. CIEDE2000 ΔE Per Class (Identification Precision)\n",
    "# ─────────────────────────────────────────────────────────────────\n",
    "print(f\"\\n{'■' * 80}\")\n",
    "print(f\"METRIC 6: CIEDE2000 ΔE PER CLASS (Identification Precision)\")\n",
    "print(f\"{'■' * 80}\\n\")\n",
    "\n",
    "def ciede2000(lab1, lab2):\n",
    "    \"\"\"\n",
    "    Compute CIEDE2000 color distance between two CIELAB colors.\n",
    "    lab1, lab2: shape (3,) with [L*, a*, b*]\n",
    "    Returns: ΔE_00 scalar\n",
    "    \"\"\"\n",
    "    L1, a1, b1 = lab1\n",
    "    L2, a2, b2 = lab2\n",
    "    \n",
    "    C1 = np.sqrt(a1**2 + b1**2)\n",
    "    C2 = np.sqrt(a2**2 + b2**2)\n",
    "    Cbar = (C1 + C2) / 2\n",
    "    \n",
    "    G = 0.5 * (1 - np.sqrt(Cbar**7 / (Cbar**7 + 25**7)))\n",
    "    a1p = (1 + G) * a1\n",
    "    a2p = (1 + G) * a2\n",
    "    \n",
    "    C1p = np.sqrt(a1p**2 + b1**2)\n",
    "    C2p = np.sqrt(a2p**2 + b2**2)\n",
    "    \n",
    "    h1p = np.arctan2(b1, a1p) * 180 / np.pi\n",
    "    if h1p < 0:\n",
    "        h1p += 360\n",
    "    h2p = np.arctan2(b2, a2p) * 180 / np.pi\n",
    "    if h2p < 0:\n",
    "        h2p += 360\n",
    "    \n",
    "    Hbar = abs(h1p - h2p)\n",
    "    if Hbar > 180:\n",
    "        Hbar = 360 - Hbar\n",
    "    \n",
    "    if Hbar <= 180:\n",
    "        dhp = h2p - h1p\n",
    "    elif h2p <= h1p:\n",
    "        dhp = h2p - h1p + 360\n",
    "    else:\n",
    "        dhp = h2p - h1p - 360\n",
    "    \n",
    "    dLp = L2 - L1\n",
    "    dCp = C2p - C1p\n",
    "    dHp = 2 * np.sqrt(C1p * C2p) * np.sin(dhp * np.pi / 360)\n",
    "    \n",
    "    Lpm = (L1 + L2) / 2\n",
    "    Cpm = (C1p + C2p) / 2\n",
    "    \n",
    "    if Hbar <= 180:\n",
    "        Hpm = (h1p + h2p) / 2\n",
    "    else:\n",
    "        if h1p + h2p < 360:\n",
    "            Hpm = (h1p + h2p) / 2 + 180\n",
    "        else:\n",
    "            Hpm = (h1p + h2p) / 2 - 180\n",
    "    \n",
    "    T = 1 - 0.17 * np.cos((Hpm - 30) * np.pi / 180) \\\n",
    "          + 0.24 * np.cos((2 * Hpm) * np.pi / 180) \\\n",
    "          + 0.32 * np.cos((3 * Hpm + 6) * np.pi / 180) \\\n",
    "          - 0.20 * np.cos((4 * Hpm - 63) * np.pi / 180)\n",
    "    \n",
    "    dhpm = 30 * np.exp(-((Hpm - 275) / 25)**2)\n",
    "    \n",
    "    Rc = 2 * np.sqrt(Cpm**7 / (Cpm**7 + 25**7))\n",
    "    \n",
    "    L_weight = 1\n",
    "    C_weight = 1 + 0.045 * Cpm\n",
    "    H_weight = 1 + 0.015 * Cpm * T\n",
    "    \n",
    "    dE = np.sqrt(\n",
    "        (dLp / (L_weight))**2 +\n",
    "        (dCp / (C_weight))**2 +\n",
    "        (dHp / (H_weight))**2 +\n",
    "        Rc * (dCp / (C_weight)) * (dHp / (H_weight))\n",
    "    )\n",
    "    \n",
    "    return float(dE)\n",
