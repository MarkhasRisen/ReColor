            <Text style={styles.readTime}>{article.readTime}</Text>
          </View>
          <Text style={styles.articleTitle}>{article.title}</Text>
          <Text style={styles.articleSummary} numberOfLines={2}>{article.summary}</Text>
        </View>
      </TouchableOpacity>
    </MotiView>
