  { name: 'Pink', hex: '#B07080', lab: rgbToLab(176, 112, 128) },   // mauve

  // ── Brown (saturated + muted) ──
  { name: 'Brown', hex: '#8B4513', lab: rgbToLab(139, 69, 19) },    // saddle brown
