@startuml FirestoreLogicalDataModel
skinparam backgroundColor #FEFEFE
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 12
skinparam shadowing false
skinparam roundcorner 8
skinparam classBorderColor #4A90D9
skinparam classBackgroundColor #E3F2FD
skinparam arrowColor #333333

title **Figure 5.2 - Firestore Logical Data Model**\n(Collection-Document Relationship Diagram)

package "Cloud Firestore Database" #F5F5F5 {

    class "**Collection: users**" as users << (C,#4CAF50) Collection >> {
        .. Document ID ..
        **auth_uid** : String <<PK>>
        __ Managed by Firebase Auth __
        (profile provisioned on login)
    }

    class "**Subcollection: users/{uid}/history**" as history << (S,#FF9800) Subcollection >> {
        .. Document ID ..
        **auto_id** : String <<Auto-generated>>
        __ Fields (from saveExamResult) __
        score : Number
        total : Number
        diagnosis : String
        severity : String
        date : Timestamp (serverTimestamp)
        --
        //Example://
        //score: 8//
        //total: 21//
        //diagnosis: "Deuteranomaly Detected"//
        //severity: "Moderate"//
        //date: 2026-04-30T10:30:00Z//
    }

    class "**Subcollection: users/{uid}/surveys**" as userSurveys << (S,#9C27B0) Subcollection >> {
        .. Document ID ..
        **auto_id** : String <<Auto-generated>>
        __ Fields __
        cause : String
        sex : String
        userId : String
        timestamp : Timestamp
    }

    class "**Collection: research_data_anonymized**" as research << (C,#2196F3) Collection >> {
        .. Document ID ..
        **auto_id** : String <<Auto-generated>>
        __ Fields (anonymized - no userId) __
        diagnosis : String
        diagnosisCode : String
        severity : String
        score : Number
        maxScore : Number
        total : Number
        device : String ("Mobile_Client")
        timestamp : Timestamp (serverTimestamp)
        --
        //Example://
        //diagnosis: "Deuteranomaly Detected"//
        //diagnosisCode: "deutan"//
        //severity: "Moderate"//
        //score: 8//
        //maxScore: 21//
        //total: 21//
        //device: "Mobile_Client"//
    }

    class "**Collection: surveys**" as surveys << (C,#E91E63) Collection >> {
        .. Document ID ..
        **auto_id** : String <<Auto-generated>>
        __ Fields __
        cause : String
        sex : String
        userId : String
        timestamp : Timestamp
        --
        //Example://
        //cause: "Genetics"//
        //sex: "Male"//
        //userId: "xR7kLm9..."//
    }

    class "**Firebase Authentication**" as authService << (A,#607D8B) Service >> {
        __ Providers __
        Google Sign-In
        Email / Password
        __ Generates __
        **auth_uid** : String <<Unique>>
    }
}

' --- Relationships ---
authService -down-> users : **provisions**\nuser document\n(1 : 1)

users "1" -right- "0..*" history : **nested subcollection**\nusers/{uid}/history

users "1" -down- "0..1" userSurveys : **nested subcollection**\nusers/{uid}/surveys

users "1" ..right.. "0..*" research : **Dual Write**\n(no userId stored;\nanonymized by design)

users "1" ..down.. "0..1" surveys : **linked by userId field**

note top of history
  **Private test history.**
  A new document is added after
  every completed Ishihara exam.
  Nested under the user document
  for access-control isolation.
end note

note right of research
  **Anonymized research data.**
  Written simultaneously with
  the private history (Dual Write).
  Contains NO userId field,
  ensuring PERI researcher access
  without exposing user identity.
end note

note bottom of users
  **Data Decoupling Strategy:**
  Test history is stored as a subcollection
  under each user document. This allows
  unlimited test records without bloating
  the parent profile document.
  The anonymized research_data_anonymized
  collection enables independent research
  queries without joining user data.
end note

@enduml
